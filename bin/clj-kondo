#!/usr/bin/env bash
# Self-extracting clj-kondo shim. Sourced releases from GitHub.

set -euo pipefail

CLJ_KONDO_VERSION="2026.07.24"
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../" && pwd)

function ensure_clj_kondo() {
    # Doesn't take args, simply reads variables set above.
    VERSION=$CLJ_KONDO_VERSION
    PLATFORM="$(uname -s)"
    ARCH="$(uname -m)"

    case "${PLATFORM}-${ARCH}" in
        Darwin-x86_64) RELEASE_TARGET="macos-amd64" ;;
        Darwin-arm64) RELEASE_TARGET="macos-aarch64" ;;
        Linux-x86_64) RELEASE_TARGET="linux-amd64" ;;
        Linux-aarch64|Linux-arm64) RELEASE_TARGET="linux-aarch64" ;;
        *)
            echo "Platform ${PLATFORM} and ${ARCH} combination is currently not supported" >&2
            exit 1
            ;;
    esac

    ARCHIVE="clj-kondo-${VERSION}-${RELEASE_TARGET}.zip"
    CACHE_DIR="$ROOT/bin/.cache/clj-kondo-${VERSION}-${RELEASE_TARGET}"
    if ! [ -f "${CACHE_DIR}/BOOTSTRAPPED" ]; then
        echo "Missing clj-kondo binary for version [${VERSION}] -- will download." >&2
        PACKAGE_FULL_URL="https://github.com/borkdude/clj-kondo/releases/download/v${VERSION}/${ARCHIVE}"
        mkdir -p "$ROOT/bin/.cache"
        pushd "$ROOT/bin/.cache" >/dev/null 2>&1 || exit 1
        echo "Downloading ${PACKAGE_FULL_URL}..." >&2
        curl -#L -O "${PACKAGE_FULL_URL}" ||
            (echo "Failed to download ${PACKAGE_FULL_URL}." && exit 1)

        (rm -rf "${CACHE_DIR}" &&
            unzip "${ARCHIVE}" -d "${CACHE_DIR}") >&2 ||
            (echo "Failed to extract ${PACKAGE_FULL_URL}." && exit 1)
        rm -rf "${ARCHIVE}"
        touch "${CACHE_DIR}/BOOTSTRAPPED"
        popd >/dev/null 2>&1 || exit 2
    fi

    CLJ_KONDO="${CACHE_DIR}/clj-kondo"
}

ensure_clj_kondo

exec "${CLJ_KONDO}" "$@"
